# Copia questo file in ".env" (in locale) oppure inserisci le stesse chiavi
# come Variabili d'Ambiente nel progetto Railway. Non caricare mai il file
# ".env" vero su GitHub.

# Chiave API di Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chiave API di Upload-Post (upload-post.com -> Dashboard -> API Keys)
UPLOADPOST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL del tuo sito, usato per i redirect dopo la connessione social
FRONTEND_URL=https://www.inpostsocial.com

# Porta locale (Railway la imposta da sola in produzione)
PORT=3000
