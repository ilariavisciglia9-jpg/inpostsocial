# =====================================================================
# INPOSTSOCIAL.AI — Variabili d'ambiente
# Su Railway: progetto → Variables (incolla nome e valore uno per uno).
# In locale: copia questo file come ".env". Il file .env vero non va mai su GitHub.
# =====================================================================

# ANTHROPIC (testi, strategia, risposte ai commenti, report)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Modello dell'agente: lascia così, oppure claude-sonnet-4-5 per testi migliori (costa di più)
AGENT_MODEL=claude-haiku-4-5-20251001

# IMMAGINI (OpenAI gpt-image-1)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# VIDEO REEL (Seedance via fal.ai)
FAL_KEY=xxxxxxxxxxxxxxxx

# META (Instagram + Facebook)
META_APP_ID=xxxxxxxxxxxxxxxx
META_APP_SECRET=xxxxxxxxxxxxxxxx

# STRIPE — un prezzo ricorrente mensile per ogni piano
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxxxxx

# SUPABASE (la chiave SERVICE va SOLO qui, mai nei file HTML)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxx

# APP
FRONTEND_URL=https://inpostsocial.ai
OWNER_EMAIL=info@inpostsocial.com
PORT=3000
